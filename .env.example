# ---------------------------------------------------------------------------
# Supabase (Project Settings → API / API Keys). Ambas son públicas por diseño:
# los datos están protegidos por RLS. NUNCA pongas aquí la clave service_role.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Anon key clásica (JWT) o, en su lugar, la nueva publishable key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcional: URL pública de la app para los enlaces de los emails de auth.
# Si no se define, se deduce de la petición (localhost en desarrollo, dominio en Vercel).
# NEXT_PUBLIC_SITE_URL=https://tu-app.vercel.app

# ---------------------------------------------------------------------------
# Avisos por email de seguimientos (opcional). SOLO SERVIDOR: nunca NEXT_PUBLIC_.
# Sin estas variables la app funciona igual; Ajustes → Avisos indica qué falta
# y /api/cron/notifications responde 503 sin marcar nada como enviado.
# ---------------------------------------------------------------------------
# Clave de API de Resend (https://resend.com → API Keys).
# RESEND_API_KEY=
# Remitente con dominio verificado en Resend.
# NOTIFICATIONS_FROM_EMAIL="Cartera CRM <avisos@tu-dominio.com>"
# Clave service_role (o secret key sb_secret_...) de Supabase. Solo la usa la tarea
# programada de avisos para leer los seguimientos de todos los usuarios.
# SUPABASE_SERVICE_ROLE_KEY=
# Secreto aleatorio que Vercel Cron envía como "Authorization: Bearer <CRON_SECRET>".
# Genera uno con: openssl rand -hex 32
# CRON_SECRET=

# Opcional: servicio de consulta de códigos postales (por defecto https://api.zippopotam.us/es).
# POSTAL_CODE_LOOKUP_URL=
